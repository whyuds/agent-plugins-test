{
  "mcpServers": {
    "update-probe": {
      "type": "stdio",
      "command": "python",
      "args": [
        "-u",
        "${CURSOR_PLUGIN_ROOT}/scripts/server.py"
      ],
      "env": {
        "UPDATE_PROBE_LOADER": "cursor-native-root",
        "PYTHONDONTWRITEBYTECODE": "1"
      },
      "cwd": "${CURSOR_PLUGIN_ROOT}"
    }
  }
}
